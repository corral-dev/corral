#!/usr/bin/env bash
# 推送前门禁：日常只拦与 CI 同源的 ruff；发版提交 / v* 标签推送跑全量 ci-test。
# 安装：bash scripts/install-git-hooks.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ "${CORRAL_SKIP_PUSH_GATE:-0}" = "1" ]; then
  echo "==> 跳过推送门禁（CORRAL_SKIP_PUSH_GATE=1）"
  exit 0
fi

need_full=0
# Git 约定：新建远端引用时 remote sha 为全 0
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  # 删除远端引用：无本地对象可检
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  case "$local_ref" in
    refs/tags/v*) need_full=1 ;;
  esac
  if [ "$remote_sha" = "$zero" ]; then
    # 新建分支：不要 git log $sha（会扫完整祖先、误把历史 release: 当成本次发版）
    # 只看「尚未出现在任何远端跟踪分支上」的提交
    subjects="$(git log --format=%s "$local_sha" --not --remotes 2>/dev/null || true)"
  else
    subjects="$(git log --format=%s "${remote_sha}..${local_sha}" 2>/dev/null || true)"
  fi
  if printf '%s\n' "$subjects" | grep -qE '^release:'; then
    need_full=1
  fi
done

export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}src"
# checkout .venv 就绪时优先用其中锁定的 ruff；缺席时保持旧 PATH 行为。
if [ -x "$ROOT/.venv/bin/ruff" ]; then
  export PATH="$ROOT/.venv/bin:$PATH"
fi
# 复现 CI：清掉本机常驻的 Kitty 开关，避免掩盖真实失败
run_ci() {
  env -u TEXTUAL_DISABLE_KITTY_KEY python3 scripts/ci-test.py "$@"
}

if [ "$need_full" -eq 1 ]; then
  if python3 scripts/ci-test.py --check-stamp >/dev/null; then
    echo "==> 完整检查已在本工作区跑过（产品代码未改），跳过重复，只再拦 ruff"
    run_ci --lint-only
  else
    echo "==> 发版推送：跑与 CI 同源的完整检查（ruff + 单测）"
    run_ci
  fi
else
  echo "==> 推送门禁：只跑 ruff（与 CI Lint 同源）；发版请用 release: 提交说明或推 v* 标签以触发全量"
  run_ci --lint-only
fi
